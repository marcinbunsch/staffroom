{
  "name": "@staffroom/mobile",
  "version": "0.5.0",
  "private": true,
  "description": "Staffroom native mobile shell — a thin Capacitor client over a running server.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "sync": "cap sync ios",
    "open": "cap open ios",
