{
  "name": "@staffroom/server",
  "version": "0.5.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": "./src/app.ts",
    "./lib": "./src/server-lib.ts",
    "./routes": "./src/routes/index.ts"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env node_modules/vite/bin/vite.js dev",
    "admin": "node --env-file-if-exists=../../.env src/scripts/create-admin.ts",
    "vapid": "node src/scripts/generate-vapid-keys.ts",
    "sandbox:build": "docker build -t \"${STAFFROOM_SANDBOX_IMAGE:-staffroom-sandbox:latest}\" -f docker/sandbox.Dockerfile .",
    "build": "vite build",
    "build:desktop": "vite build --config vite.desktop.config.ts",
    "check": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@better-auth/api-key": "^1.7.2",
    "@earendil-works/pi-ai": "0.83.0",
    "@flue/runtime": "2.0.3",
    "@flue/sdk": "2.0.3",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/client": "2.0.0",
    "@staffroom/plugin-core": "workspace:*",
    "@staffroom/protocol": "workspace:*",
    "@valibot/to-json-schema": "1.7.1",
    "better-auth": "1.7.2",
    "better-sqlite3": "^13.0.3",
    "croner": "10.0.1",
    "hono": "4.13.5",
    "kysely": "0.29.5",
    "valibot": "1.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@flue/cli": "2.0.3",
    "@flue/vite": "2.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
