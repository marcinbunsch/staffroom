# Staffroom configuration.
#
# Copy to `.env` and edit. Every value here has a working default except where
# noted, so a local run needs none of them. `.env` is loaded by `pnpm dev`,
# `pnpm serve` and the admin script; it is gitignored — keep real secrets there
# and never in this file.

# ─── Where things live ────────────────────────────────────────────────────────

# The one directory Staffroom owns: the three SQLite databases, the file bytes,
# and the generated secrets. Defaults to ~/.staffroom in production, and to
# <checkout>/.staffroom in dev so each worktree is disposable.
# STAFFROOM_HOME=/var/lib/staffroom

# The server's own public base URL. OAuth redirect URIs are built from it
# (<this>/oauth/<name>/callback), so a deployment must set it or provider
# callbacks come back to localhost. Defaults to http://127.0.0.1:4317.
# STAFFROOM_URL=https://staffroom.example.com

# ─── Listening ────────────────────────────────────────────────────────────────

# Port for the built server. Defaults to 4317.
# PORT=4317

# Address to bind. Defaults to 127.0.0.1 — loopback only, which is the right
# default for a machine that also runs a reverse proxy or `tailscale serve`.
# Set 0.0.0.0 to accept connections on every interface, and only do that behind
# TLS: this process holds model credentials and every tenant's OAuth tokens.
# STAFFROOM_HOST=0.0.0.0

# ─── Secrets ──────────────────────────────────────────────────────────────────

# The secret better-auth signs sessions and tokens with. Generated into
# $STAFFROOM_HOME/auth-secret when unset. Set it from your own secret store in
# production, or to share one secret across several machines. Changing it signs
# everyone out.
# STAFFROOM_AUTH_SECRET=

# The key that encrypts stored credentials — model API keys, OAuth tokens.
# Generated into $STAFFROOM_HOME/secret-key when unset. Losing it does not mean
# a re-login; it means every stored credential becomes unreadable, so back it up
# with the database.
# STAFFROOM_SECRET_KEY=

# ─── Accounts ─────────────────────────────────────────────────────────────────

# Sign-up closes automatically once the first account exists (that account is
# the admin). Set to 1 to keep it open — anyone who can reach the server can
# then create an account.
# STAFFROOM_OPEN_SIGNUP=1

# One account only: set by the desktop app for the server it starts on loopback.
# Sign-up is closed and teams stop gating toolsets, since there is nobody else
# to keep them from. Never set this on a shared deployment.
# STAFFROOM_SINGLE_USER=1

# The token the desktop app hands its own server so it can sign that one account
# in without a password. Generated per launch by the app; there is no reason to
# set it by hand.
# STAFFROOM_LOCAL_TOKEN=

# ─── Models ───────────────────────────────────────────────────────────────────

# Last-resort model when neither the staff member nor the credential names one.
# Credentials are configured in the UI, not here.
# STAFFROOM_DEFAULT_MODEL=

# ─── Tool sandbox (Docker) ────────────────────────────────────────────────────

# The container image agents' shell tools run in. Build it with
# `pnpm sandbox:build`. Sandboxing is skipped when Docker is unreachable.
# STAFFROOM_SANDBOX_IMAGE=staffroom-sandbox:latest
# STAFFROOM_SANDBOX_ENABLED=0        # 0 turns it off entirely
# STAFFROOM_SANDBOX_MEMORY=512m
# STAFFROOM_SANDBOX_CPUS=1
# STAFFROOM_SANDBOX_IDLE_SECONDS=900        # reap a container after this idle
# STAFFROOM_SANDBOX_EXEC_TIMEOUT_MS=120000  # cap on one exec

# Bytes of MCP tool output above which a result is truncated rather than
# returned whole. ~8 KB is roughly 2k tokens.
# STAFFROOM_MCP_SPILL_BYTES=8192

# ─── Push notifications ───────────────────────────────────────────────────────

# Web Push (browsers and installed PWAs). Generate a pair with
# `pnpm --filter @staffroom/server vapid`. Push stays off until both are set.
# STAFFROOM_VAPID_PUBLIC_KEY=
# STAFFROOM_VAPID_PRIVATE_KEY=
# STAFFROOM_VAPID_SUBJECT=mailto:you@example.com   # defaults to STAFFROOM_URL

# APNs (the iOS app). All four are required together; push is off until then.
# The key is the contents of the .p8 Apple issues — pass it inline or point at
# the file, which is the usual shape for a secret mounted into a container.
# STAFFROOM_APNS_KEY=
# STAFFROOM_APNS_KEY_FILE=/run/secrets/apns.p8
# STAFFROOM_APNS_KEY_ID=
# STAFFROOM_APNS_TEAM_ID=
# STAFFROOM_APNS_BUNDLE_ID=com.staffroom.app
# STAFFROOM_APNS_PRODUCTION=1   # unset uses Apple's sandbox gateway

# ─── Development ──────────────────────────────────────────────────────────────

# Dev server ports (`pnpm dev`). Kept off the built app's 4317/4318 so a local
# production build can run alongside.
# STAFFROOM_SERVER_PORT=5317
# STAFFROOM_UI_PORT=5318

# Where the UI dev proxy sends /api, /agents and /oauth.
# STAFFROOM_SERVER_URL=http://127.0.0.1:5317

# Directory of built UI assets for the server to serve. Defaults to the ui
# package's dist/.
# STAFFROOM_UI_DIR=

# Set to `off` to stop the scheduler opening routine timers and the deadline
# sweep — for a run that must not do background work.
# STAFFROOM_SCHEDULER=off

# The server URL the Capacitor iOS shell boots into (must be https).
# STAFFROOM_MOBILE_SERVER_URL=https://staffroom.example.com

# ─── Desktop packaging (macOS signing) ────────────────────────────────────────
#
# Only needed to build a signed/notarized .app. Real values belong in your local
# .env, never in the repo.
# STAFF_SIGN_IDENTITY=Developer ID Application: Your Name (TEAMID)
# STAFF_SIGN_APPLE_ID=you@example.com
# STAFF_SIGN_APP_PASSWORD=          # app-specific password, for notarization
# STAFF_SIGN_TEAM_ID=               # else parsed from the identity
